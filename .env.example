# Copy to .env. Real environment variables win over this file.
LISTEN_ADDR=:8080
# Optional upstream for POST /v1/proxy (automatic mode); leave empty for manual copy/paste use.
PROVIDER_URL=
# Your editable rulesets (keep on persistent storage) and the factory presets they are seeded from.
RULES_PATH=data/rulesets.yml
DEFAULT_RULES_PATH=config/default-rulesets.yml
# Built web UI served at /; the API still works if it is missing.
STATIC_DIR=web/dist
MAX_PAYLOAD_SIZE=1048576
REQUEST_TIMEOUT_SECONDS=15s
